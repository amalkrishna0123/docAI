<?xml version="1.0" encoding="utf-8"?>

<configuration>

    <appSettings>
        <add key="WSGI_HANDLER" value="medical_insurance.wsgi.application"/>
        <add key="PYTHONPATH" value="E:\GC\docAI"/>
        <add key="DJANGO_SETTINGS_MODULE" value="medical_insurance.settings"/>
    </appSettings>

    <system.webServer>

        <handlers>
            <clear />

            <add name="Python FastCGI"
                 path="*"
                 verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="E:\GC\docAI\venv\Scripts\python.exe|E:\GC\docAI\venv\Lib\site-packages\wfastcgi.py"
                 resourceType="Unspecified"/>
        </handlers>

    </system.webServer>

</configuration>